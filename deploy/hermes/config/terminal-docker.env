# Mirror of the terminal.* docker settings into ~/.hermes/.env — hermes'
# terminal tool reads these env vars, and cron-spawned agents only see the
# .env mirror, not config.yaml. Set via `hermes config set terminal.<key>`
# OR append this block to ~/.hermes/.env manually.
TERMINAL_ENV=docker
TERMINAL_DOCKER_IMAGE=hermes-toolbox:latest
TERMINAL_DOCKER_FORWARD_ENV=["OBSIDIAN_APPROVAL_SECRET"]
TERMINAL_DOCKER_EXTRA_ARGS=["--add-host=host.docker.internal:host-gateway"]
TERMINAL_DOCKER_MOUNT_CWD_TO_WORKSPACE=false
TERMINAL_CONTAINER_PERSISTENT=true
