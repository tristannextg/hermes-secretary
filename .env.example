# Hermes Obsidian Ops environment template
# Copy to .env locally. Do not commit real secrets.

VAULT_PATH=/srv/obsidian-vault
REPOS_PATH=/srv/repos

# Docker host-side mounts. For first boot, leave these on sample data.
# To test the real synced vault in dry-run mode:
# HOST_VAULT_PATH=/path/to/synced/obsidian-vault
# VAULT_MOUNT_MODE=ro
HOST_VAULT_PATH=./examples/sample_vault
HOST_REPOS_PATH=./examples/sample_repos
VAULT_MOUNT_MODE=ro

# Comma-separated paths relative to the vault root.
AGENT_ALLOWED_WRITE_DIRS=80_Agent/Briefings,80_Agent/Command Log,80_Agent/Suggestions,10_Daily,90_Attachments/Briefings
AGENT_READONLY_DIRS=00_Inbox,20_Projects,30_Areas,40_Resources,50_People,60_Decisions,70_Archive

TIMEZONE=Europe/Berlin
MORNING_BRIEFING_TIME=06:30
MORNING_BRIEFING_DAYS=Monday-Friday

# Read-only GitHub briefing data. Use a FINE-GRAINED PAT restricted to the
# listed repos with read-only permissions: Contents, Pull requests, Issues,
# Metadata. The token stays in this service; never give it to the LLM agent.
# GITHUB_REPOS is a comma-separated owner/name list.
GITHUB_TOKEN=
GITHUB_REPOS=

ARTICLE_SOURCES=config/article_sources.yaml
LEETCODE_DIFFICULTY=Easy,Medium
LEETCODE_STATE_PATH=/state/leetcode_state.json
COMMAND_INDEX_PATH=/state/command_index.json

BACKUP_BACKEND=dry-run
BACKUP_REPOSITORY_PATH=/srv/backups/obsidian-vault

DRY_RUN=true
DRY_RUN_WRITE_TO_VAULT=false
DRY_RUN_OUTPUT_PATH=state/dry_run_output
LOG_LEVEL=INFO
MAX_FILES_PER_OPERATION=5
COMMAND_APPROVAL_REQUIRED=true

# Host-side API port used by Docker Compose.
API_PORT_HOST=8765

# Vault watcher. When enabled, new @hermes commands wake the Hermes agent via
# HERMES_WAKE_URL (use http://host.docker.internal:PORT/... for an agent on the
# host). Leave HERMES_WAKE_URL empty to fall back to built-in deterministic
# command handling.
WATCH_ENABLED=false
WATCH_INTERVAL_SECONDS=15
HERMES_WAKE_URL=

# Shared secret required by /tools/apply_suggestion. Only the human-approval
# path (e.g. the Telegram approve button flow) may hold this. Empty disables
# applying suggestions entirely (fail closed).
APPROVAL_SECRET=
