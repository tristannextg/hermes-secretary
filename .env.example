# Hermes Obsidian Ops environment template
# Copy to .env locally. Do not commit real secrets.

VAULT_PATH=/srv/obsidian-vault
REPOS_PATH=/srv/repos

# Comma-separated paths relative to the vault root.
AGENT_ALLOWED_WRITE_DIRS=80_Agent/Briefings,80_Agent/Command Log,80_Agent/Suggestions,10_Daily,90_Attachments/Briefings
AGENT_READONLY_DIRS=00_Inbox,20_Projects,30_Areas,40_Resources,50_People,60_Decisions,70_Archive

TIMEZONE=Europe/Berlin
MORNING_BRIEFING_TIME=06:30
MORNING_BRIEFING_DAYS=Monday-Friday

# Keep empty until needed. Do not commit real values.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOS=

ARTICLE_SOURCES=config/article_sources.yaml
LEETCODE_DIFFICULTY=Easy,Medium
LEETCODE_STATE_PATH=/state/leetcode_state.json

BACKUP_BACKEND=dry-run
BACKUP_REPOSITORY_PATH=/srv/backups/obsidian-vault

DRY_RUN=true
LOG_LEVEL=INFO
MAX_FILES_PER_OPERATION=5
COMMAND_APPROVAL_REQUIRED=true

# Host-side API port used by Docker Compose.
API_PORT_HOST=8765
